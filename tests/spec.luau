--!nonstrict
local passed = 0
local function check(name, fn)
  fn(); passed += 1; print("PASS " .. name)
end
local function equal(a, b) assert(a == b, tostring(a) .. " ~= " .. tostring(b)) end
local function snapshot(name)
  print("SNAPSHOT " .. encode({ name = name, tree = tree, offset = offset, count = #groups }))
end
local function window(id, app, focused, workspace)
  return { id = tostring(id), app_id = app, title = app .. " window " .. tostring(id), active = focused == true,
    workspace = workspace or "DP-1:1", minimized = false, minimizable = true }
end
local function emit(windows) eventCallback("windows", windows) end
local function find(node, key)
  if node.props.key == key then return node end
  for _, child in ipairs(node.children) do local result = find(child, key); if result then return result end end
end
local function configure(key, value)
  settings[key] = value; onConfigChanged()
end
update()
eventCallback("workspaces", {
  { id = "DP-1:1", output = "DP-1", active = true, focused = true },
  { id = "DP-1:2", output = "DP-1", active = false },
  { id = "HDMI-A-1:1", output = "HDMI-A-1", active = true },
})
