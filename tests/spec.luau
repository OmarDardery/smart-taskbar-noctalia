check("all dimension combinations remain bounded", function()
  for maxWidth = 48, 500, 7 do
    for size = 12, 48, 6 do
      local c = table.clone(config); c.max_width = maxWidth; c.icon_size = size; c.min_width = 2000
      for _, factor in ipairs({1,1.05,1.15,1.5}) do
       c.hover_enlarge=true; c.hover_scale=factor
       for _, count in ipairs({0,1,5,16,100}) do
        local layout = Model.layout(c, count)
        assert(layout.width <= maxWidth and layout.collapsed <= maxWidth)
        assert(layout.capacity >= 1 and layout.viewport > 0)
        local off = Model.reveal(999, layout.capacity, count, count > 0 and count or nil)
        assert(off >= 0 and off <= math.max(0,count-layout.capacity))
       end
      end
    end
  end
end)
