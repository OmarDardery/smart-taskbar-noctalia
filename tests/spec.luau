check("hover zoom animates inside a fixed cell without resolving icons per frame", function()
  emit({window(1,"a",true),window(2,"b")})
  configure("hover_enlarge",true); configure("hover_scale",1.15); configure("animations",true)
  local key=groups[1].key
  local rootWidth=tree.props.width
  local itemWidth=find(tree,key).props.width
  local lookups=resolverCalls
  find(tree,key).props.onHover("true")
  equal(find(tree,"icon:"..key).props.scale,1)
  now+=config.animation_duration/2; update()
  local scale=find(tree,"icon:"..key).props.scale
  assert(scale>1 and scale<1.15)
  now+=config.animation_duration; update()
  equal(find(tree,"icon:"..key).props.scale,1.15)
  equal(tree.props.width,rootWidth); equal(find(tree,key).props.width,itemWidth)
  equal(resolverCalls,lookups)
  find(tree,key).props.onHover("false")
  now+=config.animation_duration+1; update()
  equal(find(tree,"icon:"..key).props.scale,1)
end)
