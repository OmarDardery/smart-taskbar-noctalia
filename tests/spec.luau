  Compositor.event(b,"WindowsChanged",{windows={{id=10,app_id="a",workspace_id=2,is_focused=true}}})
  Compositor.event(b,"WorkspacesChanged",{workspaces={{id=2,idx=1,output="DP-1",is_active=true}}})
  equal(Compositor.snapshot(b)[1].output,"DP-1")
  Compositor.event(b,"WindowOpenedOrChanged",{window={id=11,app_id="a",workspace_id=2}})
  Compositor.event(b,"WindowFocusChanged",{id=11}); equal(b.windows[2].focused,true)
  assert(Compositor.action(b,noctalia,"focus",b.windows[2]))
  equal(calls[#calls][1],"niri"); equal(calls[#calls][6],"11")
  assert(not Compositor.action(b,noctalia,"minimize",b.windows[2]))
  Compositor.event(b,"WindowClosed",{id=11}); equal(#b.windows,1)
  Compositor.event(b,"reset",nil); equal(#b.windows,0)
end)
